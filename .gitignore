# Local Claude overrides (contains credentials)
CLAUDE.local.md

# Dependencies
node_modules/
.pnp
.pnp.js

# Testing
coverage/
**/coverage/
*.lcov
.nyc_output
junit.xml
test-results/
playwright-report/

# Production builds
dist/
build/
out/
.next/
**/.next/

# Environment variables - NEVER commit secrets!
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
.env.production

# Keep only example/template env files
!.env.example
!.env.test
!.env.load-test

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pnpm-debug.log*

# OS
.DS_Store
*.swp
*.swo
*~
Thumbs.db

# IDE
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.atom/
.nova/

# Temporary files
*.tmp
*.temp
.tmp-ops-watchdog-*/
.tmp-health-guardian-*/
.cache/
.turbo/
.swc/
**/.swc/

# Database
*.db
*.sqlite
*.sqlite3

# Uploads/Storage (binary files, not code)
uploads/
**/uploads/
/storage/
# Generated content thumbnails (runtime artifacts of dev uploads).
# Keep the directory structure but ignore the generated PNGs/JPGs.
middleware/static/thumbnails/*
!middleware/static/thumbnails/.gitkeep

# Docker
docker-compose.override.yml

# NX
.nx/

# Android signing (NEVER commit keystores or signing credentials).
# A private repo is not a key vault — repo access spreads to developers, CI and
# integrations. The off-machine backup is an ENCRYPTED copy on a VPS path
# outside every web/Docker/app root; see docs/plans/2026-08-10-tv-apk-distribution.md
*.keystore
*.jks
*.p12
keystore.properties
*.jks.enc

# APK staging dir used by the release runbook (`gh release download --dir .tmp-apk`).
# Without this a stray `git add .` commits a multi-MB binary.
.tmp-apk/

# Electron builds — anchored to the electron-builder output dir
# (display/package.json directories.output). An unanchored `release/` also
# matched scripts/release/, silently un-tracking source that belongs in git.
display/release/

# Archived/unused files
unusedInCode/

# Misc
*.tsbuildinfo
**/*.tsbuildinfo

# Nested git repos / worktrees
vizora/
# But allow com/vizora paths in Android native code
!**/com/vizora/

# Local Claude settings
.claude/settings.local.json

# Debug artifacts
.logcat_out.txt
.ssh_*.txt
.ssh_out*.txt
emulator-*.png

# Inventory / exploration scratch (regenerable; not source of truth)
skills-inventory-findings.txt
